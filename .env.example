# Copy to `.env` and fill in. Never commit a real .env — see docs/phase-0-architecture.md §22.
#
# THIS FILE IS THE *HOST* PROFILE: the values below are what `npm run dev`,
# `npm run test:integration` and the Prisma CLI use from your machine, so the
# database is at 127.0.0.1 (the port docker compose publishes) and the origin is
# the `next dev` one. The prod-parity Compose stack does NOT read DATABASE_URL or
# AUTH_URL from here — inside a container `localhost` is that container. It
# derives the container database URL from the POSTGRES_* values against the
# `postgres` service name, and the public origin from PUBLIC_URL/CADDY_HTTP_PORT.
# See docker/docker-compose.yml.
#
# Env carries INFRASTRUCTURE AND SECRETS ONLY. Per-store business settings
# (delivery fee, minimum order, slot length and capacity, price-variance
# tolerance, substitution policy, POS mode) live in the `StoreSettings` table and
# are edited from the admin dashboard.

# ---------------------------------------------------------------------------
# Required — the app refuses to boot without these
# ---------------------------------------------------------------------------

# local | ci | staging | production
APP_ENV=local

# PostgreSQL connection string *as seen from the host*.
# `docker compose -f docker/docker-compose.yml up -d postgres` publishes the dev
# database on 127.0.0.1:5432. Keep the credentials in step with POSTGRES_* below.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/supermarket

# Auth.js signing secret, at least 32 characters. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=replace-me-with-at-least-32-characters-of-random

# Public origin the app is served from, for `npm run dev`.
# (The Compose stack uses PUBLIC_URL instead — it is served through Caddy.)
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional — sensible defaults apply when unset
# ---------------------------------------------------------------------------

# Fixed for the pilot; the only supported value.
DEFAULT_CURRENCY=INR

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# In-process rate limiting (single app instance in V1).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Error tracking (Sentry / GlitchTip). No-op when unset.
# SENTRY_DSN=

# S3-compatible object storage — only needed if delivery proof photos are on.
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=

# ---------------------------------------------------------------------------
# docker compose only — the container profile
# ---------------------------------------------------------------------------
# The stack builds the container DATABASE_URL from these three against the
# `postgres` service hostname; it never uses the host DATABASE_URL above. Change
# them here and the host URL together, or the two profiles drift apart.

# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=supermarket

# Host port the database is published on (what the host DATABASE_URL points at).
# POSTGRES_HOST_PORT=5432

# Ports Caddy listens on, and the public origin the app is told it is served
# from. PUBLIC_URL defaults to http://localhost:${CADDY_HTTP_PORT}.
# CADDY_HTTP_PORT=8080
# CADDY_HTTPS_PORT=8443
# PUBLIC_URL=http://localhost:8080

# Hostname Caddy should serve (and obtain a certificate for). Empty = plain :80.
# DOMAIN=
